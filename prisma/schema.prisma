generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  FREE_MEMBER
  PAID_MEMBER
  CONTENT_ADMIN
  PLATFORM_ADMIN
}

enum MarketingConsentAction {
  OPT_IN
  OPT_OUT
}

enum EmailEnrollmentStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum EmailJobStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  CANCELLED
}

enum SquadStatus {
  DRAFT
  OPEN
  CLOSED
}

enum SquadMembershipStatus {
  ACTIVE
  WAITLISTED
  LEFT
  REMOVED
}

enum SquadReportStatus {
  OPEN
  REVIEWED
  CLOSED
}

enum SquadReportCategory {
  SAFETY
  CONDUCT
  OTHER
}

enum SquadNotificationKind {
  JOINED
  WAITLISTED
  PROMOTED
  LEFT
  REMOVED
}

enum SquadConsentAction {
  OPT_IN
  OPT_OUT
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  name                String?
  passwordHash        String
  role                UserRole             @default(FREE_MEMBER)
  sessionVersion      Int                  @default(0)
  emailVerified       DateTime?
  disabledAt          DateTime?
  deletionRequestedAt DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  lessonProgress      LessonProgress[]
  trackerEntries      TrackerEntry[]
  squadMemberships    SquadMembership[]
  squadReports        SquadReport[]        @relation("SquadReportReporter")
  squadNotifications  SquadNotification[]
  resetTokens         PasswordResetToken[]
  entitlements        Entitlement[]

  @@index([role, disabledAt])
}

model Lead {
  id                  String                    @id @default(cuid())
  email               String                    @unique
  firstRequestedAt    DateTime                  @default(now())
  lastRequestedAt     DateTime                  @default(now())
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  consentEvents       MarketingConsentEvent[]
  blueprintDeliveries BlueprintDelivery[]
  sequenceEnrollments EmailSequenceEnrollment[]

  @@index([lastRequestedAt])
}

model MarketingConsentEvent {
  id             String                    @id @default(cuid())
  leadId         String
  action         MarketingConsentAction
  consentVersion String
  createdAt      DateTime                  @default(now())
  lead           Lead                      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  enrollments    EmailSequenceEnrollment[]

  @@index([leadId, createdAt])
}

model BlueprintDelivery {
  id                String         @id @default(cuid())
  leadId            String
  guideVersion      String         @default("v1")
  tokenHash         String         @unique
  tokenExpiresAt    DateTime
  status            EmailJobStatus @default(PENDING)
  attempts          Int            @default(0)
  downloadCount     Int            @default(0)
  nextAttemptAt     DateTime       @default(now())
  lockedAt          DateTime?
  providerMessageId String?
  sentAt            DateTime?
  lastError         String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  lead              Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([leadId, guideVersion])
  @@index([status, nextAttemptAt])
  @@index([providerMessageId])
}

model EmailSequenceStep {
  id          String     @id @default(cuid())
  sequenceKey String     @default("blueprint-onboarding")
  stepNumber  Int
  delayDays   Int
  subject     String
  bodyText    String     @db.Text
  isEnabled   Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  jobs        EmailJob[]

  @@unique([sequenceKey, stepNumber])
  @@index([sequenceKey, isEnabled, stepNumber])
}

model EmailSequenceEnrollment {
  id             String                @id @default(cuid())
  leadId         String
  consentEventId String
  sequenceKey    String                @default("blueprint-onboarding")
  consentVersion String
  status         EmailEnrollmentStatus @default(ACTIVE)
  startedAt      DateTime              @default(now())
  pausedAt       DateTime?
  cancelledAt    DateTime?
  completedAt    DateTime?
  lead           Lead                  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  consentEvent   MarketingConsentEvent @relation(fields: [consentEventId], references: [id], onDelete: Cascade)
  jobs           EmailJob[]

  @@unique([consentEventId, sequenceKey])
  @@index([status, startedAt])
}

model EmailJob {
  id                String                  @id @default(cuid())
  enrollmentId      String
  stepId            String
  idempotencyKey    String                  @unique
  scheduledAt       DateTime
  status            EmailJobStatus          @default(PENDING)
  attempts          Int                     @default(0)
  nextAttemptAt     DateTime                @default(now())
  lockedAt          DateTime?
  providerMessageId String?
  sentAt            DateTime?
  lastError         String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  enrollment        EmailSequenceEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  step              EmailSequenceStep       @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, stepId])
  @@index([status, nextAttemptAt])
  @@index([providerMessageId])
}

model EmailAutomationControl {
  id        String   @id @default("default")
  paused    Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

model EmailProviderEvent {
  id                String   @id @default(cuid())
  providerEventId   String   @unique
  providerMessageId String
  eventType         String
  occurredAt        DateTime
  createdAt         DateTime @default(now())

  @@index([providerMessageId, occurredAt])
}

model Entitlement {
  id        String    @id @default(cuid())
  userId    String
  key       String
  source    String    @default("manual")
  grantedAt DateTime  @default(now())
  expiresAt DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId, revokedAt, expiresAt])
}

model LearningPath {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  description  String
  displayOrder Int      @default(0)
  isPublished  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  lessons      Lesson[]

  @@index([isPublished, displayOrder])
}

model Lesson {
  id           String           @id @default(cuid())
  pathId       String
  slug         String
  title        String
  summary      String
  body         String           @db.Text
  youtubeUrl   String?
  thumbnailUrl String?
  durationMins Int?
  displayOrder Int              @default(0)
  isPublished  Boolean          @default(false)
  publishedAt  DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  path         LearningPath     @relation(fields: [pathId], references: [id], onDelete: Cascade)
  progress     LessonProgress[]

  @@unique([pathId, slug])
  @@index([isPublished, displayOrder])
}

model LessonProgress {
  id          String   @id @default(cuid())
  userId      String
  lessonId    String
  completedAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId, completedAt])
}

model TrackerEntry {
  id         String   @id @default(cuid())
  userId     String
  entryDate  DateTime @db.Date
  mood       Int
  energy     Int
  stress     Int
  reflection String?  @db.VarChar(500)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, entryDate])
}

model AccountabilityGroup {
  id                 String              @id @default(cuid())
  name               String              @db.VarChar(100)
  description        String              @db.VarChar(1000)
  capacity           Int                 @default(8)
  currentMemberCount Int                 @default(0)
  status             SquadStatus         @default(DRAFT)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  memberships        SquadMembership[]
  reports            SquadReport[]
  notifications      SquadNotification[]

  @@index([status, createdAt])
}

model SquadMembership {
  id            String                @id @default(cuid())
  groupId       String
  userId        String
  status        SquadMembershipStatus @default(WAITLISTED)
  policyVersion String?
  agreedAt      DateTime?
  joinedAt      DateTime?
  waitlistedAt  DateTime?
  leftAt        DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  group         AccountabilityGroup   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkIns      SquadCheckIn[]
  reports       SquadReport[]         @relation("SquadReportSubject")
  consentEvents SquadConsentEvent[]

  @@unique([groupId, userId])
  @@index([groupId, status, waitlistedAt])
  @@index([userId, status])
}

model SquadConsentEvent {
  id            String             @id @default(cuid())
  membershipId  String
  action        SquadConsentAction
  policyVersion String
  createdAt     DateTime           @default(now())
  membership    SquadMembership    @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([membershipId, createdAt])
}

model SquadCheckIn {
  id           String          @id @default(cuid())
  membershipId String
  weekStart    DateTime        @db.Date
  focus        String          @db.VarChar(400)
  reflection   String          @db.VarChar(400)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  membership   SquadMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([membershipId, weekStart])
  @@index([weekStart])
}

model SquadReport {
  id           String              @id @default(cuid())
  groupId      String
  reporterId   String
  membershipId String
  category     SquadReportCategory
  details      String              @db.VarChar(1000)
  status       SquadReportStatus   @default(OPEN)
  createdAt    DateTime            @default(now())
  reviewedAt   DateTime?
  group        AccountabilityGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  reporter     User                @relation("SquadReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  membership   SquadMembership     @relation("SquadReportSubject", fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([groupId, createdAt])
}

model SquadNotification {
  id        String                @id @default(cuid())
  userId    String
  groupId   String?
  kind      SquadNotificationKind
  createdAt DateTime              @default(now())
  readAt    DateTime?
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group     AccountabilityGroup?  @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@index([userId, readAt, createdAt])
}

model ExternalResource {
  id              String   @id @default(cuid())
  name            String
  description     String   @db.Text
  url             String
  category        String
  compatibility   String[]
  costInformation String?
  privacyNotes    String?  @db.Text
  displayOrder    Int      @default(0)
  isPublished     Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([isPublished, displayOrder])
}

model SecurityEvent {
  id        String   @id @default(cuid())
  bucket    String
  createdAt DateTime @default(now())

  @@index([bucket, createdAt])
}

model VerificationToken {
  id         String    @id @default(cuid())
  email      String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email, expiresAt])
}

model PasswordResetToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  entityType String
  entityId   String
  summary    String
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([entityType, entityId, createdAt])
}
