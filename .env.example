# Server-only database connection. Use a dedicated development database locally.
DATABASE_URL=

# Generate a strong random value with `npx auth secret` and store it in your deployment secret manager.
AUTH_SECRET=
AUTH_TRUST_HOST=false
AUTH_SIGNUPS_ENABLED=false
ACCOUNT_POLICIES_APPROVED=false

# Public URL used to construct email links and SEO metadata after approval.
APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_INDEXING_ENABLED=false

# Required before verification/password recovery email can be delivered.
RESEND_API_KEY=
EMAIL_FROM=
RESEND_WEBHOOK_SECRET=
CRON_SECRET=

# Owner approval and private guide required before the lead form can collect email addresses.
BLUEPRINT_FILE_PATH=
BLUEPRINT_CONSENT_APPROVED=false
BLUEPRINT_CONSENT_VERSION=
BLUEPRINT_RETENTION_DAYS=

# Community member access stays closed until the owner approves guidelines and sets their version.
SQUADS_POLICIES_APPROVED=false
SQUADS_POLICY_VERSION=
SQUADS_POLICY_TEXT=
